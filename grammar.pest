// Reference-only EBNF of the ipfw(8) ruleset subset the parser accepts,
// in pest syntax, copied from the Rust crate and kept in sync by hand. It
// is not used to generate anything.
//
// The Go port implements everything below plus what the grammar leaves as
// TODO or omits: rule numbers, `log [logamount N]`, `tag N`, `skipto`
// (label, number, tablearg), `check-state [:flow]`, `table(NAME)` targets,
// hostnames (plain and backtick-quoted), the option list after the
// destination (in/out, established, frag, diverted, antispoof, keep-state,
// icmptypes, icmp6types, tcpflags, src-port, dst-port, proto, via, `{ ...
// or ... }` groups, `//` comments), `table NAME create|add` commands,
// `:LABEL` lines and `#` comments. Actions other than pass, deny, count,
// skipto and check-state are not accepted.

// RULE
rule                   = { command ~ (ws1 ~ rule_number)? ~ (ws1 ~ set_number)? ~ (ws1 ~ match_prob)? ~ ws1 ~ action ~ (ws1 ~ log)? ~ (ws1 ~ altq)? ~ (ws1 ~ tag_action)? ~ ws1 ~ rule_body }
rule_body              = { rule_body_compat }
rule_body_compat       = { rule_body_compat_proto ~ ws1 ~ "from" ~ ws1 ~ rule_body_compat_src ~ ws1 ~ "to" ~ ws1 ~ rule_body_compat_dst }
rule_body_compat_proto = { protocol_or | protocol }
rule_body_compat_src   = { target_spec }
rule_body_compat_dst   = { target_spec }

// COMMAND
command = { "add" }

// UNCLASSIFIED
rule_number = { number }
set_number  = { "set" ~ ws1 ~ number }
match_prob  = { "prob" ~ ws1 ~ "TODO" }
log         = { "log" ~ "TODO" }
altq        = { "altq" ~ ws1 ~ "TODO" }
tag_action  = { "TODO" }

// MACRO
macro      =  { "_" ~ ((!"_" ~ macro_char)+ ~ "_"+)+ }
macro_char = _{ any_except_ws_char }

// OTHER
protocol_or          =  { "{" ~ ws0 ~ protocol ~ (ws1 ~ "or" ~ ws1 ~ protocol)* ~ ws0 ~ "}" }
protocol             =  { (neg ~ ws1)? ~ (protocol_keyword | protocol_number | protocol_name) }
protocol_keyword     =  {
    protocol_keyword_ip4
  | protocol_keyword_ip6
  | protocol_keyword_all
}
protocol_keyword_ip4 =  { "ip4" | "ipv4" }
protocol_keyword_ip6 =  { "ip6" | "ipv6" }
protocol_keyword_all =  { "ip" | "all" }
protocol_number      =  { number }
protocol_name        =  { protocol_char+ }
protocol_char        = _{ (ASCII_ALPHANUMERIC | "-") }

target_spec = { net_target ~ (ws1 ~ ports_target_spec)? }

net_target         = { net_target_or_spec | net_target_spec }
net_target_or_spec = {
    "{" ~ ws0 ~ net_target_spec ~ (ws1 ~ "or" ~ ws1 ~ net_target_spec)* ~ ws0 ~ "}"
}
net_target_spec    = { (neg ~ ws1)? ~ target }
target             = {
    target_any
  | target_me6
  | target_me
  | target_table
  | target_addr_list
}
target_any         = { "any" }
target_me6         = { "me6" }
target_me          = { "me" }
target_table       = { "TODO" }
target_addr_list   = { target_addr ~ ("," ~ target_addr)* }
target_addr        = {
    ipv4_network
  | ipv6_network
}

// IPv4
ipv4_network =  { ipv4_addr ~ ("/" ~ ipv4_mask)? }
ipv4_addr    =  { ipv4_octet ~ "." ~ ipv4_octet ~ "." ~ ipv4_octet ~ "." ~ ipv4_octet }
ipv4_octet   = _{
    "25" ~ '0'..'5'
  | "2" ~ '0'..'4' ~ ASCII_DIGIT
  | "1" ~ ASCII_DIGIT{2}
  | ('1'..'9') ~ ASCII_DIGIT
  | ASCII_DIGIT
}
ipv4_mask    =  { ipv4_addr | ipv4_masklen }
ipv4_masklen =  {
    "3" ~ '0'..'2'
  | '1'..'2' ~ ASCII_DIGIT
  | ASCII_DIGIT
}

// IPv6
ipv6_network =  { ipv6_addr ~ ("/" ~ ipv6_mask)? }
ipv6_addr    =  {
    (h16 ~ ":"){6} ~ ls32
  | "::" ~ (h16 ~ ":"){5} ~ ls32
  | h16 ~ "::" ~ (h16 ~ ":"){4} ~ ls32
  | h16 ~ (":" ~ h16){,1} ~ "::" ~ (h16 ~ ":"){3} ~ ls32
  | h16 ~ (":" ~ h16){,2} ~ "::" ~ (h16 ~ ":"){2} ~ ls32
  | h16 ~ (":" ~ h16){,3} ~ "::" ~ h16 ~ ":" ~ ls32
  | h16 ~ (":" ~ h16){,4} ~ "::" ~ ls32
  | h16 ~ (":" ~ h16){,5} ~ "::" ~ h16
  | h16 ~ (":" ~ h16){,6} ~ "::"
}
ls32         = _{ (h16 ~ ":" ~ h16) | ipv4_addr }
h16          = _{ ASCII_HEX_DIGIT{1, 4} }
ipv6_mask    =  { ipv6_addr | ipv6_masklen }
ipv6_masklen =  { number }

ports_target_spec  = { (neg ~ ws1)? ~ ports_target }
ports_target       = { port_or_port_range ~ ("," ~ port_or_port_range)* }
port_or_port_range = {
    port_range
  | port
}
port               = { port_number | port_string }
port_number        = { number }
// A backslash escapes a dash in a service name (`ftp\-data`).
port_string = { any_except_ws }
port_range  = { port ~ "-" ~ port }

neg = { "not" }

comment = { "#" ~ "TODO" }

action            = {
    action_pass
  | action_checkstate
  | action_count
  | action_deny
  | action_divert
  | action_fwd
  | action_nat
  | action_nat64lsn
  | action_nat64stl
  | action_nat64clat
  | action_ntpv6
  | action_pipe
  | action_queue
  | action_reject
  | action_reset
  | action_reset6
  | action_skipto
  | action_call
  | action_return
  | action_tee
  | action_unreach
  | action_unreach6
  | action_netgraph
  | action_ngtee
  | action_setfib
  | action_setdscp
  | action_tcp_setmss
  | action_reass
  | action_abort
  | action_abort6
}
action_pass       = { "allow" | "accept" | "pass" | "permit" }
action_checkstate = { "check-state" ~ (ws1 ~ ":" ~ action_checkstate_flow_name)? }
action_count      = { "count" }
action_deny       = { "deny" | "drop" }
action_divert     = { "TODO" }
action_fwd        = { "TODO" }
action_nat        = { "TODO" }
action_nat64lsn   = { "TODO" }
action_nat64stl   = { "TODO" }
action_nat64clat  = { "TODO" }
action_ntpv6      = { "TODO" }
action_pipe       = { "TODO" }
action_queue      = { "TODO" }
action_reject     = { "TODO" }
action_reset      = { "TODO" }
action_reset6     = { "TODO" }
action_skipto     = { "TODO" }
action_call       = { "TODO" }
action_return     = { "TODO" }
action_tee        = { "TODO" }
action_unreach    = { "TODO" }
action_unreach6   = { "TODO" }
action_netgraph   = { "TODO" }
action_ngtee      = { "TODO" }
action_setfib     = { "TODO" }
action_setdscp    = { "TODO" }
action_tcp_setmss = { "TODO" }
action_reass      = { "TODO" }
action_abort      = { "TODO" }
action_abort6     = { "TODO" }

action_checkstate_flow_name = { any_except_ws }

number             = _{ ASCII_DIGIT+ }
hex_number         = _{ "0x" ~ ASCII_HEX_DIGIT+ }
ws0                = _{ WHITE_SPACE* }
ws1                = _{ WHITE_SPACE+ }
any_except_ws      =  { any_except_ws_char+ }
any_except_ws_char =  { (!WHITE_SPACE ~ ANY) }
